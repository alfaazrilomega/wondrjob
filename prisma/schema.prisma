generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  password         String?
  role             UserRole  @default(SOCIETY)
  phone            String?
  address          String?
  date_of_birth    DateTime?
  profile_picture  String?
  createdAt        DateTime  @default(now())
  twoFactorEnabled Boolean   @default(false)
  Admin            Admin?
  company          Company?
  hrd              HRD?
  society          Society?
  skills           Skill[]   @relation("SkillToUser")

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollows")
}

model Admin {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String?
  phone         String?
  address       String?
  date_of_birth DateTime?
  user_id       String    @unique
  user          User      @relation(fields: [user_id], references: [id])
}

model HRD {
  id         Int     @id @default(autoincrement())
  user_id    String  @unique
  company_id Int
  company    Company @relation(fields: [company_id], references: [id])
  user       User    @relation(fields: [user_id], references: [id])
}

model Society {
  id                 Int               @id @default(autoincrement())
  name               String
  address            String
  phone              String
  date_of_birth      DateTime
  gender             String?
  user_id            String            @unique
  location           String?
  headline           String?
  about              String?
  profile_picture    String?
  available_dates    DateTime[]
  occupation         String?
  social_media_url   String?
  working_papers_url String?
  most_memorable_tip String?
  portofolio         Portofolio[]
  applied_jobs       PositionApplied[]
  user               User              @relation(fields: [user_id], references: [id])
}

model Company {
  id                    Int                   @id @default(autoincrement())
  name                  String
  address               String
  phone                 String
  description           String
  user_id               String                @unique
  logo                  String?
  tagline               String?
  companyCertificateUrl String?
  website               String?
  jobs                  AvailablePosition[]
  jobDrafts             JobDraft[]
  user                  User                  @relation(fields: [user_id], references: [id])
  monthlyStats          CompanyMonthlyStats[]
  hrds                  HRD[]

  Follow Follow[] @relation("CompanyFollowers")
}

model CompanyMonthlyStats {
  id          Int     @id @default(autoincrement())
  companyId   Int
  month       Int
  year        Int
  successRate Float
  revenue     Float   @default(0) // Added revenue
  expenses    Float   @default(0) // Added expenses
  netIncome   Float   @default(0) // Added net income
  company     Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, month, year])
}

model AvailablePosition {
  id                    Int               @id @default(autoincrement())
  position_name         String
  capacity              Int
  description           String
  submission_start_date DateTime
  submission_end_date   DateTime
  company_id            Int
  department            String?
  location              String?
  jobType               JobType?
  salaryMax             Int?
  salaryMin             Int?
  workStyle             WorkStyle?
  company               Company           @relation(fields: [company_id], references: [id])
  embedding             JobEmbedding?
  applicants            PositionApplied[]
  skills                Skill[]           @relation("AvailablePositionToSkill")

  @@index([company_id])
}

model Portofolio {
  id                 Int                 @id @default(autoincrement())
  skill              String
  description        String
  file               String
  society_id         Int
  PortfolioEmbedding PortfolioEmbedding?
  society            Society             @relation(fields: [society_id], references: [id])
}

model PositionApplied {
  id                    Int               @id @default(autoincrement())
  available_position_id Int
  society_id            Int
  apply_date            DateTime          @default(now())
  status                ApplicationStatus @default(PENDING)
  resume                String?
  coverLetter           String?
  earliestStartDate     DateTime?
  expectedSalary        Int?
  referral              String?
  workPermit            Boolean?
  position              AvailablePosition @relation(fields: [available_position_id], references: [id])
  society               Society           @relation(fields: [society_id], references: [id])

  @@index([available_position_id])
  @@index([status])
}

model JobEmbedding {
  id          String            @id @default(cuid())
  jobId       Int               @unique
  embedding   Json
  skills      String[]
  description String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  job         AvailablePosition @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model PortfolioEmbedding {
  id          String     @id @default(cuid())
  portfolioId Int        @unique
  embedding   Json
  skills      String[]
  description String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  portfolio   Portofolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Skill {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  category  String
  aliases   String[]            @default([])
  jobs      AvailablePosition[] @relation("AvailablePositionToSkill")
  jobDrafts JobDraft[]          @relation("JobDraftToSkill")
  users     User[]              @relation("SkillToUser")
}

model Setting {
  key   String @id
  value Json
}

model RolePermission {
  id         Int     @id @default(autoincrement())
  role       String
  permission String
  enabled    Boolean @default(false)

  @@unique([role, permission])
}

model Follow {
  id                Int      @id @default(autoincrement())
  followerId        String // ID of the user doing the following
  follower          User     @relation("UserFollows", fields: [followerId], references: [id])
  followedUserId    String? // when following another user
  followedUser      User?    @relation("UserFollowers", fields: [followedUserId], references: [id])
  followedCompanyId Int? // when following a company
  followedCompany   Company? @relation("CompanyFollowers", fields: [followedCompanyId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([followerId, followedUserId])
  @@unique([followerId, followedCompanyId])
  @@index([followerId])
  @@index([followedUserId])
  @@index([followedCompanyId])
}

enum UserRole {
  ADMIN
  SOCIETY
  COMPANY
  HRD
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkStyle {
  ON_SITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JobDraft {
  id                    Int            @id @default(autoincrement())
  position_name         String
  capacity              Int
  description           String
  submission_start_date DateTime
  submission_end_date   DateTime
  company_id            Int
  department            String?
  location              String?
  jobType               JobType?
  salaryMax             Int?
  salaryMin             Int?
  workStyle             WorkStyle?
  status                DraftStatus    @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdBy             String // HRD user_id
  company               Company        @relation(fields: [company_id], references: [id])
  skills                Skill[]        @relation("JobDraftToSkill")
  notifications         Notification[]

  @@index([company_id])
  @@index([status])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  recipientId String // Company Owner user_id
  senderId    String? // HRD user_id who created the draft
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  jobDraftId  Int?
  jobDraft    JobDraft?        @relation(fields: [jobDraftId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([isRead])
  @@index([jobDraftId])
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  JOB_APPROVAL_REQUEST
  JOB_APPROVAL_ACCEPTED
  JOB_APPROVAL_REJECTED
  APPLICANT_UPDATE
  INFO
}
